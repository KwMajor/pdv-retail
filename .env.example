# Copie para .env: cp .env.example .env
POSTGRES_USER=pdv
POSTGRES_PASSWORD=pdv
POSTGRES_DB=pdv
POSTGRES_PORT=5432

# SQLx / backend (mesmo banco do compose acima)
DATABASE_URL=postgres://pdv:pdv@localhost:5432/pdv

# Segredo HMAC do JWT (US02): mínimo 32 chars. Produção exige valor forte.
JWT_SECRET=troque-em-producao-por-segredo-de-32-mais-chars
